{
  "name": "product-engineer",
  "version": "0.3.0",
  "description": "Your agent ships code. product-engineer makes it ship outcomes. Four agent skills plus a zero-dependency check for the For-the-customer block in commit messages and pull requests.",
  "type": "module",
  "bin": {
    "product-engineer": "bin/check.mjs"
  },
  "exports": {
    ".": "./bin/check.mjs",
    "./commitlint": "./integrations/commitlint/config.mjs",
    "./commitlint/plugin": "./integrations/commitlint/index.mjs"
  },
  "files": [
    "bin",
    "skills",
    "integrations",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "private": false,
  "scripts": {
    "test": "sh test/skill-structure.sh && sh test/commit-msg.test.sh && node --test test/check.test.mjs test/pr.test.mjs test/adapters.test.mjs test/score.test.mjs test/integrations.test.mjs test/readability.test.mjs && node scripts/generate-adapters.mjs --check test/release.test.mjs",
    "prepublishOnly": "npm test",
    "release": "node scripts/release.mjs",
    "release-gate": "node scripts/release-gate.mjs",
    "release:prepare": "node scripts/generate-adapters.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-skills",
    "skills",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli",
    "ai-agents",
    "commit-message",
    "pull-request",
    "commitlint",
    "pre-commit",
    "git-hooks",
    "product-engineering",
    "plain-language",
    "release-notes"
  ],
  "author": "Efe Genc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bubblegunn/product-engineer.git"
  },
  "homepage": "https://bubblegunn.github.io/product-engineer/",
  "bugs": {
    "url": "https://github.com/Bubblegunn/product-engineer/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
