# VHS tape for the README demo: vhs scripts/demo.tape
# Records the same two commands whose literal output is drawn in assets/check-demo.svg.
Output assets/check-demo.gif
Set FontSize 14
Set Width 900
Set Height 360
Type "product-engineer check test/fixtures/without-block.txt" Enter Sleep 2s
Type "product-engineer check test/fixtures/with-block.txt" Enter Sleep 3s
